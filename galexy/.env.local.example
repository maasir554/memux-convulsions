# --- memux chat: cloud (Google AI Studio) keys ------------------------------
#
# Copy to .env.local and fill in real keys to enable the Cloud mode in the
# memux chat. The frontend's Settings dialog gates Cloud mode on the value
# of /api/settings.ready, which is true iff at least one key is loaded.
#
# Failover: keys are tried round-robin (loaded by KeyRotator) and a single
# 401/403/429/5xx fails over to the next key automatically.

NUM_KEYS_GOOGLE=0

# GOOGLE_AI_1=
# GOOGLE_AI_2=
# ...

# --- memux backend (Phase 1+: auth, Phase 3+: teams) -----------------------
#
# URL of the memux-backend Worker. Used by the Better-Auth client and any
# future calls into /api/teams. Public on purpose (NEXT_PUBLIC_) so it's
# available in the browser bundle.

NEXT_PUBLIC_MEMUX_API_URL=http://localhost:8787
