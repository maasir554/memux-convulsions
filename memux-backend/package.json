{
  "name": "memux-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply memux --local",
    "db:migrate:remote": "wrangler d1 migrations apply memux --remote",
    "auth:generate": "better-auth generate --config src/auth.ts --output src/db/auth-schema.sql"
  },
  "dependencies": {
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250121.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
