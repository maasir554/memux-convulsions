# Google AI Studio (Gemini) API keys for the cloud backend.
# Round-robin: each request picks the next key. On 401/403/429 the backend
# falls through to the next key automatically.
#
# Set NUM_KEYS_GOOGLE to the exact count of keys you have configured below,
# then list them as GOOGLE_AI_1, GOOGLE_AI_2, … up to that count.

NUM_KEYS_GOOGLE=0

# GOOGLE_AI_1=
# GOOGLE_AI_2=
# GOOGLE_AI_3=
# GOOGLE_AI_4=
# GOOGLE_AI_5=

# Optional: override the listening port (default 8787).
# PORT=8787
